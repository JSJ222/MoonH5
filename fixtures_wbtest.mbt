///| Files are generated by scripts/interop.py with h5py; they are independent
///| of MoonH5's writer. No external data or upstream test assets are copied.
test "h5py historical and current metadata encodings read on every backend" {
  for fixture in [fixture_earliest(), fixture_v108(), fixture_latest()] {
    let file = H5File::open(fixture)
    assert_eq(file.read("/run/samples").signed_at(11), 11L)
    assert_eq(file.read("/relative").signed_at(5), 5L)
    assert_eq(file.read("/scalar").signed_at(0), -9223372036854775808L)
    assert_eq(file.read("/fill").signed_at(3), -7L)
    assert_eq(file.read("/labels").string_at(1), "two")
    assert_eq(file.read("/null").dataspace(), Null)
    assert_eq(file.read("/empty").dataspace(), Simple([0, 3]))
    assert_eq(file.attributes(path="/run")[0].value.string_at(0), "K")
  }
}

///|
test "h5py raw and compressed edge chunks map to row-major arrays" {
  for fixture in [fixture_earliest(), fixture_v108()] {
    let file = H5File::open(fixture)
    for path in ["/run/chunked", "/run/filtered"] {
      let data = file.read(path)
      assert_eq(data.dataspace(), Simple([5, 7]))
      for i = 0; i < 35; i = i + 1 { assert_eq(data.signed_at(i), i.to_int64()) }
      let selection = Selection::new(data.space, [
        { start: 1, stride: 3, count: 2, block: 1 },
        { start: 2, stride: 2, count: 3, block: 1 },
      ])
      assert_eq(file.read_selection(path, selection).bytes(), data.select(selection).bytes())
    }
  }
}

///|
test "userblock multiple Btree leaves and sparse chunks interoperate" {
  let file = H5File::open(fixture_edge())
  let values = file.read("/many_chunks")
  assert_eq(values.length(), 437)
  for i = 0; i < 437; i = i + 1 { assert_eq(values.signed_at(i), i.to_int64()) }
  let cube = file.read("/cube")
  for i = 0; i < 60; i = i + 1 { assert_eq(cube.unsigned_at(i), i.to_uint64()) }
  let sparse = file.read("/sparse")
  for i = 0; i < 35; i = i + 1 { assert_eq(sparse.signed_at(i), if i == 9 { 77L } else { -9L }) }
  assert_eq(file.read("/u64").unsigned_at(0), 0xffffffffffffffffUL)
  assert_eq(file.attributes()[0].value.unsigned_at(1), 2UL)
  let floats = file.read("/big_endian_float")
  assert_eq(floats.float_at(0), 1.25)
  assert_eq(floats.float_at(1).reinterpret_as_uint64(), 0x8000000000000000UL)
  assert_true(floats.float_at(2).is_inf())
  assert_true(floats.float_at(3).is_nan())
}

///|
test "unsupported modern indexes dense groups and vlen do not return guessed data" {
  let file = H5File::open(fixture_unsupported())
  assert_true(try { ignore(file.read("/modern_chunks")); false } catch { _ => true })
  assert_true(try { ignore(file.links(path="/dense")); false } catch { _ => true })
  assert_true(try { ignore(file.read("/vlen")); false } catch { _ => true })
}

///|
test "h5py input can be repacked with semantic values and aliases intact" {
  let input = H5File::open(fixture_v108())
  let output = H5File::open(input.to_document().encode())
  assert_eq(input.read("/run/filtered").bytes(), output.read("/run/filtered").bytes())
  assert_eq(output.object_address("/same"), output.object_address("/run/samples"))
  assert_eq(output.read("/relative").signed_at(10), 10L)
}
