///|
test "corrupt filtered payloads never become plausible numeric arrays" {
  let bytes = fixture_v108()
  let file = H5File::open(bytes)
  let chunk = file.chunks("/run/filtered")[0]
  for shift in [0, 1, chunk.stored_bytes - 1] {
    let bad = bytes.to_array()
    let at = chunk.address + shift
    bad[at] = (bad[at].to_int() ^ 1).to_byte()
    let corrupted = H5File::open(Bytes::from_array(bad))
    assert_true(
      try {
        ignore(corrupted.read("/run/filtered"))
        false
      } catch {
        _ => true
      },
    )
  }
}

///|
test "modern fixed-array header checksum is independent of object checksum" {
  let bytes = fixture_latest()
  let file = H5File::open(bytes)
  guard file.dataset_info("/run/chunked").storage
    is FixedArray(Some(address), _, _) else {
    fail("expected independent fixed-array fixture")
  }
  let bad = bytes.to_array()
  bad[address + 9] = (bad[address + 9].to_int() ^ 128).to_byte()
  let corrupted = H5File::open(Bytes::from_array(bad))
  assert_true(
    try {
      ignore(corrupted.chunks("/run/chunked"))
      false
    } catch {
      _ => true
    },
  )
}

///|
test "bounded DEFLATE rejects oversized and trailing streams" {
  // Standard zlib stream generated by Python zlib.compress(b'a' * 100).
  let compressed = b"\x78\x9c\x4b\x4c\xa4\x3d\x00\x00\x7a\x47\x25\xe5"
  assert_eq(
    inflate_zlib(compressed, 100),
    Bytes::from_array(Array::make(100, b'a')),
  )
  assert_true(
    try {
      ignore(inflate_zlib(compressed, 99))
      false
    } catch {
      _ => true
    },
  )
  let bad_adler = compressed.to_array()
  bad_adler[11] = 0
  assert_true(
    try {
      ignore(inflate_zlib(Bytes::from_array(bad_adler), 100))
      false
    } catch {
      _ => true
    },
  )
  let extended = compressed[:8].to_owned() + b"\x00" + compressed[8:].to_owned()
  assert_true(
    try {
      ignore(inflate_zlib(extended, 100))
      false
    } catch {
      _ => true
    },
  )
}

///|
test "byte-range planning never reads an unselected corrupted chunk" {
  let bytes = fixture_v108()
  let file = H5File::open(bytes)
  let last = file.chunks("/run/filtered").last().unwrap()
  let bad = bytes.to_array()
  bad[last.address] = (bad[last.address].to_int() ^ 1).to_byte()
  let corrupted = H5File::open(Bytes::from_array(bad))
  let selection = Selection::new(Simple([5, 7]), [
    { start: 0, stride: 1, count: 1, block: 1, },
    { start: 0, stride: 1, count: 1, block: 1, },
  ])
  assert_eq(
    corrupted.read_selection("/run/filtered", selection).signed_at(0),
    0L,
  )
  assert_true(
    try {
      ignore(corrupted.read("/run/filtered"))
      false
    } catch {
      _ => true
    },
  )
}

///|
test "absent chunks fill a hyperslab without reading any stored bytes" {
  let file = H5File::open(fixture_edge())
  let selection = Selection::new(Simple([5, 7]), [
    { start: 4, stride: 1, count: 1, block: 1, },
    { start: 4, stride: 1, count: 3, block: 1, },
  ])
  let data = file.read_selection("/sparse", selection)
  assert_eq(data.length(), 3)
  for i = 0; i < 3; i = i + 1 {
    assert_eq(data.signed_at(i), -9L)
  }
}

///|
test "filter masks outside the declared pipeline are rejected" {
  assert_true(
    try {
      ignore(decode_filters(b"a", [], 1U, 1, 1, Limits::default()))
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      ignore(
        decode_filters(
          b"ab",
          [{ id: 2, optional: false, parameters: [4], }],
          0U,
          2,
          2,
          Limits::default(),
        ),
      )
      false
    } catch {
      _ => true
    },
  )
}
